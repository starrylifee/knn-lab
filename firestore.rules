rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인(익명 인증)을 거친 요청만 허용. 인터넷 무단 접근 차단.
    function signedIn() { return request.auth != null; }

    // 학생 제출물이 담기는 컬렉션만 허용(임의 이름 스팸 방지).
    function allowedSub(sub) {
      return sub in ['cards', 'entries', 'prefs', 'plans', 'reviews', 'compare', 'ideas'];
    }

    // 출석번호는 반드시 정수 1~40 (문자열/스크립트 저장 차단 = num XSS 근절).
    function validNum(d) {
      return d.num is int && d.num >= 1 && d.num <= 40;
    }

    // 구글 계정으로 로그인한 교사만 (학생은 익명 로그인)
    function isTeacher() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /classes/{code} {
      allow get: if signedIn();
      // 교사는 자기 학급만 목록 조회 가능 (where ownerUid == 내 uid 쿼리만 통과)
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      allow create: if isTeacher()
        && request.resource.data.keys().hasAll(['grade', 'name', 'pinHash', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && !('pin' in request.resource.data);

      // settings 토글 등만 허용. 학년·이름·PIN·생성일은 잠금.
      // 소유자만 수정 가능. 소유자 없는 옛 학급은 교사가 1회 연결(claim) 가능.
      allow update: if signedIn()
        && request.resource.data.grade == resource.data.grade
        && request.resource.data.name == resource.data.name
        && request.resource.data.pinHash == resource.data.pinHash
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (
          (resource.data.get('ownerUid', null) == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid)
          || (resource.data.get('ownerUid', null) == null
            && isTeacher()
            && request.resource.data.ownerUid == request.auth.uid)
        );

      allow delete: if false;

      match /{sub}/{doc} {
        allow read: if signedIn();

        allow create: if signedIn()
          && allowedSub(sub)
          && request.resource.data.owner == request.auth.uid
          && validNum(request.resource.data);

        allow update: if signedIn()
          && allowedSub(sub)
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid
          && validNum(request.resource.data);

        // 본인이 쓴 문서만 스스로 지울 수 있음.
        allow delete: if signedIn()
          && resource.data.owner == request.auth.uid;
      }
    }
  }
}
